pragma solidity 0.8.28;
import {IndependentB,HostilePolicyB,MoneyB} from "./IndependentB.t.sol";
import {PoolBalancer} from "../src/PoolBalancer.sol";
import {KeeperPolicyV1} from "../src/KeeperPolicyV1.sol";
import {BalancerFactory} from "../src/BalancerFactory.sol";
import {FreezableNFT,ReentrantNFT,GasBurnNFT} from "../test/utils/Mocks.sol";
import {IERC721Min} from "../src/interfaces/External.sol";
import {ListOne} from "../test/utils/ListOne.sol";
using ListOne for PoolBalancer;
contract SecurityB is IndependentB {
 function testSecurityUnknownCallerCannotMoveAssetsOrRights() public {start(20,1 ether,2500);uint liquid=address(balancer).balance;uint[] memory one=new uint[](1);one[0]=2;vm.startPrank(stranger);vm.expectRevert();balancer.claimSurplus(1,stranger);vm.expectRevert();balancer.unlistShapes(one);vm.expectRevert();balancer.withdrawCurated(1,stranger);vm.expectRevert();balancer.transferCreator(stranger);vm.expectRevert();balancer.close();vm.expectRevert();balancer.configure(1000,1);vm.expectRevert();balancer.proposeKeeperPolicy(address(new KeeperPolicyV1()));vm.expectRevert();balancer.setPaidUpkeepEnabled(false);vm.stopPrank();assertEq(address(balancer).balance,liquid);assertEq(nft.ownerOf(1),address(pool));assertEq(balancer.creator(),creator);vm.startPrank(creator);vm.expectRevert();balancer.recoverUntrackedNFT(address(pool),0,stranger);vm.expectRevert();balancer.recoverUntrackedNFT(FWA_FACTORY,0,stranger);vm.stopPrank();unwind();}
 function testSecurityPolicyDelayDisableAndCreatorTransferInvalidate() public {start(20,1 ether,2500);HostilePolicyB p=new HostilePolicyB();vm.prank(creator);balancer.proposeKeeperPolicy(address(p));vm.expectRevert();balancer.activateKeeperPolicy();uint activation=balancer.policyActivationTime();vm.warp(activation);vm.prank(creator);balancer.setPaidUpkeepEnabled(false);assertEq(balancer.pendingKeeperPolicy(),address(0));vm.expectRevert();balancer.activateKeeperPolicy();vm.prank(creator);balancer.proposeKeeperPolicy(address(p));assertEq(balancer.policyActivationTime(),activation+2 days);vm.prank(creator);balancer.transferCreator(stranger);vm.prank(stranger);balancer.acceptCreator();assertEq(balancer.pendingKeeperPolicy(),address(0));vm.prank(creator);vm.expectRevert();balancer.claimSurplus(1,creator);assertEq(balancer.creator(),stranger);}
 function testSecurityPolicyFailurePreservesUnpaidRecovery() public {start(20,1 ether,1500);HostilePolicyB p=new HostilePolicyB();vm.prank(creator);balancer.proposeKeeperPolicy(address(p));vm.warp(block.timestamp+2 days);balancer.activateKeeperPolicy();uint[] memory one=new uint[](1);one[0]=2;vm.prank(creator);balancer.unlistShapes(one);p.setBroken(true);uint before=address(balancer).balance;bytes32 h=balancer.settingsHash();vm.prank(keeper);vm.expectRevert();balancer.performUpkeep(h,0);assertEq(address(balancer).balance,before);vm.prank(stranger);balancer.performUpkeepUnpaid();assertEq(balancer.getActiveShapes()[0],20);assertEq(before-address(balancer).balance,0.011 ether);uint[] memory ids=balancer.getActiveIds();uint last=ids[ids.length-1];(,,,,uint112 price)=balancer.items(last);assertEq(price,0.013195 ether);vm.prank(creator);balancer.close();unwind();}
 function testSecurityAtomicRewardFloorRevertsWork() public {createBalancer(1 ether);configure(20);listCurated(1,1 ether);vm.prank(creator);balancer.open();uint before=address(balancer).balance;uint count=pool.activeListingCount();bytes32 h=balancer.settingsHash();vm.prank(keeper);vm.expectRevert();balancer.performUpkeep(h,0.312 ether);assertEq(address(balancer).balance,before);assertEq(pool.activeListingCount(),count);assertEq(balancer.getActiveShapes()[0],0);vm.prank(keeper);vm.expectRevert();balancer.performUpkeep(h,0,1000000000);assertEq(pool.activeListingCount(),count);uint pay=ownKeep();assertGt(pay,0);assertLe(pay,0.01645 ether);quiesce();unwind();}
 function testSecurityHostilePolicyBoundAndNoOpCannotDrain() public {fees(0.01 gwei);start(20,1 ether,1000);HostilePolicyB p=new HostilePolicyB();vm.prank(creator);balancer.proposeKeeperPolicy(address(p));vm.warp(block.timestamp+2 days);balancer.activateKeeperPolicy();uint[] memory one=new uint[](1);one[0]=2;vm.prank(creator);balancer.unlistShapes(one);uint kb=keeper.balance;uint pay=ownKeep();assertEq(keeper.balance-kb,pay);assertGt(pay,0);assertLe(pay,0.000119 ether);uint before=address(balancer).balance;bytes32 h=balancer.settingsHash();vm.prank(keeper);vm.expectRevert();balancer.performUpkeep(h,0);assertEq(address(balancer).balance,before);assertLe(balancer.availableKeeperAllowance(),0.622 ether);emit log_named_uint("hostilePolicyLowGasActualPay",pay);unwind();}
 function testSecurityFactoryDefaultDoesNotChangeExistingAssets() public {start(20,1 ether,1500);address selected=balancer.keeperPolicy();HostilePolicyB p=new HostilePolicyB();factory.proposeDefaultKeeperPolicy(address(p));vm.expectRevert();factory.activateDefaultKeeperPolicy();vm.warp(block.timestamp+2 days);vm.prank(stranger);factory.activateDefaultKeeperPolicy();assertEq(factory.defaultKeeperPolicy(),address(p));assertEq(balancer.keeperPolicy(),selected);assertEq(pool.owner(),address(balancer));vm.prank(keeperAdmin);factory.setKeepersRestricted(true);uint[] memory one=new uint[](1);one[0]=2;vm.prank(creator);balancer.unlistShapes(one);bytes32 h=balancer.settingsHash();vm.prank(keeper);vm.expectRevert();balancer.performUpkeep(h,0);vm.prank(keeperAdmin);factory.setKeeperApproved(keeper,true);ownKeep();{uint[] memory ids=balancer.getActiveIds();one[0]=ids[ids.length-1];}vm.prank(creator);balancer.unlistShapes(one);vm.prank(keeperAdmin);factory.setKeeperApproved(keeper,false);vm.prank(creator);balancer.performUpkeep(h,0);{uint[] memory ids=balancer.getActiveIds();one[0]=ids[ids.length-1];}vm.prank(creator);balancer.unlistShapes(one);vm.prank(stranger);balancer.performUpkeepUnpaid();vm.prank(keeperAdmin);factory.setKeepersRestricted(false);unwind();}
 function testSecurityFailedDeliveryOnlyBuyerRefundThenCreatorRecovery() public {start(20,1 ether,2500);FreezableNFT hostile=new FreezableNFT();hostile.mint(creator,99);vm.startPrank(creator);hostile.approve(address(balancer),99);uint lid=balancer.listCurated(address(hostile),99,0.05 ether);vm.stopPrank();(,,,,,,uint slot,)=pool.listings(lid);uint word=wordForSlot(slot);(uint fee,,)=pool.quoteAcquisitionPrice(1);uint[] memory req=buy(buyer,1);hostile.setFrozen(true);fulfill(req[0],word);quiesce();(,,,uint selected,uint8 status,)=pool.acquisitions(req[0]);assertEq(selected,lid);assertEq(status,7);assertEq(MoneyB(address(pool)).deliveryEscrowTotal(),fee);assertEq(hostile.ownerOf(99),address(pool));vm.prank(creator);vm.expectRevert();balancer.recoverRefunded(lid,creator);vm.prank(stranger);vm.expectRevert();pool.refundFailedDelivery(lid);vm.prank(buyer);vm.expectRevert();pool.refundFailedDelivery(lid);vm.prank(creator);balancer.close();uint before=buyer.balance;vm.warp(block.timestamp+7 days);vm.prank(buyer);pool.refundFailedDelivery(lid);assertEq(MoneyB(address(pool)).deliveryEscrowTotal(),0);assertEq(MoneyB(address(pool)).acquisitionRefundCredit(buyer),fee);vm.prank(buyer);MoneyB(address(pool)).withdrawAcquisitionRefund();assertEq(buyer.balance-before,fee);hostile.setFrozen(false);vm.prank(creator);balancer.recoverRefunded(lid,creator);assertEq(hostile.ownerOf(99),creator);unwind();}
 function testSecurityCollectionHookCannotReenterGuardedMoney() public {start(20,1 ether,2500);ReentrantNFT hostile=new ReentrantNFT();hostile.mint(creator,99);hostile.setTarget(address(balancer));vm.startPrank(creator);hostile.approve(address(balancer),99);uint lid=balancer.listCurated(address(hostile),99,0.05 ether);vm.stopPrank();assertFalse(hostile.reentered());assertEq(hostile.ownerOf(99),address(pool));vm.prank(creator);balancer.withdrawCurated(lid,creator);assertFalse(hostile.reentered());assertEq(hostile.ownerOf(99),creator);unwind();}
 function testSecurityPageApprovalRevokedByCreatorTransfer() public {start(20,1 ether,2500);bytes32 digest;vm.prank(creator);digest=balancer.approvePoolPage("2026-11-18T02:15:00.000Z",keccak256("metadata"));assertEq(balancer.isValidSignature(digest,""),bytes4(0x1626ba7e));assertEq(balancer.isValidSignature(keccak256("other arbitrary permission"),""),bytes4(0xffffffff));vm.prank(creator);balancer.transferCreator(stranger);vm.prank(stranger);balancer.acceptCreator();assertEq(balancer.isValidSignature(digest,""),bytes4(0xffffffff));}
 function testSecurityPlanAndMarkupHardBounds() public {createBalancer(100 ether);vm.startPrank(creator);vm.expectRevert();balancer.configure(999,1);vm.expectRevert();balancer.configure(10001,1);vm.expectRevert();balancer.configure(1000,0);vm.expectRevert();balancer.configure(1000,1001);balancer.configure(10000,uint(1000)<<240);vm.stopPrank();assertEq(balancer.target(),uint(1000)<<240);assertEq(balancer.markupBps(),10000);}
}
