pragma solidity 0.8.28;
import {IndependentB} from "./IndependentB.t.sol";
import {PoolBalancer} from "../src/PoolBalancer.sol";
import {IKeeperPolicy} from "../src/interfaces/IKeeperPolicy.sol";
import {AcquiringNFT,GasBurnNFT} from "../test/utils/Mocks.sol";
import {ListOne} from "../test/utils/ListOne.sol";
using ListOne for PoolBalancer;
contract WritePolicyB {uint public hits;function interfaceVersion() external pure returns(uint){return 1;}function maxReward() external pure returns(uint){return 0.311 ether;}function quoteReward(IKeeperPolicy.Work calldata) external returns(uint){hits++;return 1;}function quoteRestock(uint8,uint,uint) external pure returns(uint){return 0;}}
contract BombPolicyB {function interfaceVersion() external pure returns(uint){return 1;}function maxReward() external pure returns(uint){return 0.311 ether;}function quoteReward(IKeeperPolicy.Work calldata) external pure returns(uint){assembly("memory-safe"){return(0,100000)}}function quoteRestock(uint8,uint,uint) external pure returns(uint){return 0;}}
contract HostileSurfacesB is IndependentB {
 function policyAttempt(address p) internal {start(20,1 ether,2500);vm.prank(creator);balancer.proposeKeeperPolicy(p);vm.warp(block.timestamp+2 days);balancer.activateKeeperPolicy();uint[] memory one=new uint[](1);one[0]=2;vm.prank(creator);balancer.unlistShapes(one);uint balance=address(balancer).balance;bytes32 h=balancer.settingsHash();vm.prank(keeper);vm.expectRevert();balancer.performUpkeep{gas:5000000}(h,0);assertEq(address(balancer).balance,balance);assertEq(balancer.getActiveShapes()[0],19);vm.prank(stranger);balancer.performUpkeepUnpaid();assertEq(balancer.getActiveShapes()[0],20);unwind();}
 function testSecurityPolicyWritesDeniedByStaticExecution() public {WritePolicyB p=new WritePolicyB();policyAttempt(address(p));assertEq(p.hits(),0);}
 function testSecurityPolicyReturndataBombBoundedAndRecoverable() public {policyAttempt(address(new BombPolicyB()));}
 function testSecurityCollectionCanBuyInPullHookWithoutCrossingCustody() public {start(20,1 ether,2500);uint w=wordForSlot(2);AcquiringNFT hostile=new AcquiringNFT();hostile.mint(creator,99);(,,uint quote)=pool.quoteAcquisitionPrice(1);vm.deal(address(this),quote);hostile.arm{value:quote}(address(pool));vm.startPrank(creator);hostile.approve(address(balancer),99);uint lid=balancer.listCurated(address(hostile),99,0.05 ether);vm.stopPrank();assertTrue(hostile.acquired());assertEq(pool.unsettledAcquisitionCount(),1);(,,,,,,,uint8 status)=pool.listings(lid);assertEq(status,5);assertEq(hostile.ownerOf(99),address(pool));hostile.arm(address(0));uint req=pool.requestIdAtSequence(1);fulfill(req,w);quiesce();(,,,uint won,uint8 astatus,)=pool.acquisitions(req);assertEq(astatus,2);(,,,uint id,,,,)=pool.listings(won);assertEq(shapes.ownerOf(id),address(hostile));assertEq(shapes.backingOf(id),0.01 ether);unwind();}
 function testSecurityGasBurnCollectionQuarantinedWithinRealProcessor() public {start(20,1 ether,2500);GasBurnNFT hostile=new GasBurnNFT();hostile.mint(creator,99);vm.startPrank(creator);hostile.approve(address(balancer),99);uint lid=balancer.listCurated(address(hostile),99,0.05 ether);vm.stopPrank();(,,,,,,uint slot,)=pool.listings(lid);uint w=wordForSlot(slot);uint[] memory req=buy(buyer,1);hostile.setBurn(true);fulfill(req[0],w);quiesce();(,,,uint won,uint8 status,)=pool.acquisitions(req[0]);assertEq(won,lid);assertEq(status,7);assertEq(pool.unsettledAcquisitionCount(),0);assertEq(hostile.ownerOf(99),address(pool));vm.warp(block.timestamp+7 days);vm.prank(buyer);pool.refundFailedDelivery(lid);hostile.setBurn(false);vm.prank(creator);balancer.recoverRefunded(lid,creator);assertEq(hostile.ownerOf(99),creator);unwind();}
}
