contract MinimumClaimComparisonB is GasSpikeValidatedB {
 uint internal paidFailures;uint internal partialPasses;uint internal claims;uint internal claimWei;
 function claimMax() internal {uint amount=balancer.withdrawableSurplus();if(amount!=0){vm.prank(creator);balancer.claimSurplus(amount,creator);claims++;claimWei+=amount;}}
 function maintainAndClaim() internal {for(uint n;n<50;n++){bytes32 h=balancer.settingsHash();vm.prank(keeper,keeper);try balancer.performUpkeep(h,0){claimMax();}catch(bytes memory reason){if(bytes4(reason)!=bytes4(keccak256("NoUpkeepNeeded()"))){paidFailures++;emit log_named_bytes("paidUpkeepFailure",reason);}uint[16] memory counts;uint16[16] memory have=balancer.getActiveShapes();uint t=balancer.target();for(uint d;d<16;d++){counts[d]=(t>>(16*d))&65535;if(have[d]<counts[d]){partialPasses++;break;}}return;}}revert("maintenance loop");}
 function testEconomicMinimumOpeningClaimMaxGasSpike() public {fees(0.1 gwei);Ledger memory l;l.shapeBal=SHAPES.balance;l.shapeFees=ExternalMoneyB(SHAPES).pendingFees();l.vrfTreasury=VRF_SERVICE.balance+ExternalMoneyB(VRF_SERVICE).subscriptionNativeBalance();l.buyerETH=buyer.balance;uint creatorBefore=creator.balance;KeeperPolicyCalls.Reserve memory r;r.enabled=true;r.target=board();r.mintFee=shapes.mintFee();r.baseFee=block.basefee;uint minimum=KeeperPolicyCalls.reserve(0.01645 ether,r);vm.recordLogs();createBalancer(minimum-1);vm.prank(creator);balancer.configure(2500,board());listCurated(1,1 ether);vm.prank(creator);vm.expectRevert();balancer.open();vm.prank(creator);balancer.depositETH{value:1}();vm.prank(creator);balancer.open();fillUp();assertFalse(balancer.creatorWork());l.keeperETH=keeper.balance;claimMax();uint admitted;uint refused;uint lowRefused;uint highRefused;uint afterRefused;uint paidSurcharge;uint backing;for(uint i;i<180;i++){if(i==60)transition(4.95 gwei);if(i==120)transition(0.1 gwei);maintainAndClaim();if(balancer.admissionStatus()!=0){refused++;if(i<60)lowRefused++;else if(i<120)highRefused++;else afterRefused++;vm.roll(block.number+12);vm.warp(block.timestamp+120);continue;}uint oldBlock=block.number;(,uint vrf,)=pool.quoteAcquisitionPrice(1);uint surcharge=expectedSurcharge();uint[] memory req=buy(buyer,1);admitted++;l.vrfPaid+=vrf;fulfill(req[0],uint(keccak256(abi.encode(i+1000,"independent B"))));maintainAndClaim();(,,,uint lid,uint8 status,)=pool.acquisitions(req[0]);assertEq(status,2,"admitted buyer fulfilled");(address collection,,,uint id,,,,)=pool.listings(lid);if(collection==SHAPES)backing+=shapes.backingOf(id);else if(collection==packs){(bool ok,bytes memory data)=packs.staticcall(abi.encodeWithSignature("valueOf(uint256)",id));require(ok);backing+=abi.decode(data,(uint));}else{assertEq(nft.ownerOf(id),buyer);listCurated(newCuratedB++,curatedPriceB);curatedContributionsB++;}paidSurcharge+=surcharge;vm.roll(oldBlock+12);vm.warp(block.timestamp+120);}maintainAndClaim();uint endAdmission=balancer.admissionStatus();uint endBalance=address(balancer).balance;uint endRequired=balancer.requiredReserve();uint playKeeper=keeper.balance-l.keeperETH;assertEq(pool.unsettledAcquisitionCount(),0);assertEq(MoneyB(address(pool)).acquisitionEscrowTotal(),0);assertEq(MoneyB(address(pool)).deliveryEscrowTotal(),0);assertEq(MoneyB(address(pool)).acquisitionRefundCreditTotal(),0);unwind();uint allReturns=creator.balance-creatorBefore+minimum;Vm.Log[] memory logs=vm.getRecordedLogs();uint minted;for(uint i;i<logs.length;i++){if(logs[i].emitter==SHAPES&&logs[i].topics.length==4&&logs[i].topics[0]==keccak256("Transfer(address,address,uint256)")&&logs[i].topics[1]==bytes32(0))minted++;}uint mintFees=ExternalMoneyB(SHAPES).pendingFees()-l.shapeFees;uint edge=MoneyB(address(pool)).accruedProtocolFees();uint allKeeper=keeper.balance-1 ether;assertEq(mintFees,minted*0.001 ether);assertEq(SHAPES.balance-l.shapeBal,mintFees+backing);assertEq(VRF_SERVICE.balance+ExternalMoneyB(VRF_SERVICE).subscriptionNativeBalance()-l.vrfTreasury,l.vrfPaid);assertEq(minimum+l.buyerETH-buyer.balance,allReturns+backing+mintFees+l.vrfPaid+edge+allKeeper,"minimum bankroll everywei ledger");emit log_named_uint("minimumActualOpeningETH",minimum);emit log_named_uint("plannedAttempts",180);emit log_named_uint("admittedFulfilled",admitted);emit log_named_uint("refused",refused);emit log_named_uint("normalBeforeRefusals",lowRefused);emit log_named_uint("highGasRefusals",highRefused);emit log_named_uint("normalAfterRefusals",afterRefused);emit log_named_uint("paidUpkeepFailures",paidFailures);emit log_named_uint("partialInventoryObservations",partialPasses);emit log_named_uint("creatorClaimCalls",claims);emit log_named_uint("creatorInterimClaims",claimWei);emit log_named_uint("finalAdmission",endAdmission);emit log_named_uint("finalLiquidBeforeClose",endBalance);emit log_named_uint("finalRequirementBeforeClose",endRequired);emit log_named_uint("buyerPaid",l.buyerETH-buyer.balance);emit log_named_uint("buyerBacking",backing);emit log_named_uint("mintFeeCredits",mintFees);emit log_named_uint("VRFAtRest",l.vrfPaid);emit log_named_uint("FWAEdgeAtRest",edge);emit log_named_uint("allKeeperPayouts",allKeeper);emit log_named_uint("playKeeperPayouts",playKeeper);emit log_named_uint("requestBoardSurcharge",paidSurcharge);emit log_named_uint("creatorAllReturns",allReturns);emit log_named_uint("creatorNewNFTContributions",curatedContributionsB);emit log_named_uint("buyerObligationsAfterClose",MoneyB(address(pool)).acquisitionEscrowTotal()+MoneyB(address(pool)).deliveryEscrowTotal()+MoneyB(address(pool)).acquisitionRefundCreditTotal());}
}
