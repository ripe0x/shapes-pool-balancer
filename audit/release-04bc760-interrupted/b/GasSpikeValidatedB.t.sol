pragma solidity 0.8.28;
import {IndependentB,MoneyB} from "./IndependentB.t.sol";
import {Vm} from "forge-std/Vm.sol";
interface ExternalMoneyB {function pendingFees() external view returns(uint);function redeemableBacking() external view returns(uint);function subscriptionNativeBalance() external view returns(uint);}
contract GasSpikeValidatedB is IndependentB {
 struct Ledger {uint shapeBal;uint shapeFees;uint vrfTreasury;uint buyerETH;uint keeperETH;uint buyerBacking;uint vrfPaid;uint surcharge;uint pay;uint minted;uint mintFees;uint returned;uint edge;uint ratio;}
 function transition(uint target) internal {uint current=block.basefee;while(current!=target){uint next;if(current<target){next=current+current/8;if(next>target)next=target;assertLe(next-current,current/8);}else{next=current-current/8;if(next<target)next=target;assertLe(current-next,current/8);}vm.roll(block.number+1);vm.warp(block.timestamp+12);fees(next);current=next;}emit log_named_uint("feeTransitionEndsAtBlock",block.number);}
 function testEconomicGasSpikeValidatedFullCashCycle() public {fees(0.1 gwei);Ledger memory l;l.shapeBal=SHAPES.balance;l.shapeFees=ExternalMoneyB(SHAPES).pendingFees();l.vrfTreasury=VRF_SERVICE.balance+ExternalMoneyB(VRF_SERVICE).subscriptionNativeBalance();l.buyerETH=buyer.balance;vm.recordLogs();start(board(),5 ether,2500);l.keeperETH=keeper.balance;for(uint i;i<180;i++){if(i==60)transition(4.95 gwei);if(i==120)transition(0.1 gwei);(,uint vrf,)=pool.quoteAcquisitionPrice(1);l.vrfPaid+=vrf;(uint backing,uint surcharge,uint ratio)=onePlay(i+1000,type(uint).max);l.buyerBacking+=backing;l.surcharge+=surcharge;if(i>=120&&ratio>l.ratio)l.ratio=ratio;}l.pay=keeper.balance-l.keeperETH;uint cb=creator.balance;unwind();l.returned=creator.balance-cb;l.edge=MoneyB(address(pool)).accruedProtocolFees();Vm.Log[] memory logs=vm.getRecordedLogs();for(uint i;i<logs.length;i++){if(logs[i].emitter==SHAPES&&logs[i].topics.length==4&&logs[i].topics[0]==keccak256("Transfer(address,address,uint256)")&&logs[i].topics[1]==bytes32(0))l.minted++;}l.mintFees=ExternalMoneyB(SHAPES).pendingFees()-l.shapeFees;assertEq(l.mintFees,l.minted*0.001 ether);assertEq(SHAPES.balance-l.shapeBal,l.mintFees+l.buyerBacking,"all final Shapes ETH split into buyer backing and fee recipient credit");assertEq(VRF_SERVICE.balance+ExternalMoneyB(VRF_SERVICE).subscriptionNativeBalance()-l.vrfTreasury,l.vrfPaid,"every VRF fee at rest in actual service/coordinator treasury");assertEq(address(pool).balance,l.edge,"only protocol edge remains in FWA");uint allKeeper=keeper.balance-1 ether;assertEq(5 ether+l.buyerETH-buyer.balance,l.returned+l.buyerBacking+l.mintFees+l.vrfPaid+l.edge+allKeeper,"every wei destination over the whole cash cycle");emit log_named_uint("gasSpikeOwnerContribution",5 ether);emit log_named_uint("gasSpikeBuyerPaid",l.buyerETH-buyer.balance);emit log_named_uint("gasSpikeBuyerBacking",l.buyerBacking);emit log_named_uint("gasSpikeMintedShapes",l.minted);emit log_named_uint("gasSpikeShapesFeeCredits",l.mintFees);emit log_named_uint("gasSpikeVRFTreasuryIncrease",l.vrfPaid);emit log_named_uint("gasSpikeFWAEdgeAtRest",l.edge);emit log_named_uint("gasSpikeAllKeeperPayouts",allKeeper);emit log_named_uint("gasSpikePlaySurchargeIncome",l.surcharge);emit log_named_uint("gasSpikePlayKeeperPayouts",l.pay);emit log_named_uint("gasSpikeCreatorCloseoutReturned",l.returned);emit log_named_uint("gasSpikeCreatorNewNFTContributions",curatedContributionsB);emit log_named_uint("gasSpikeLaterNormalRatioBps",l.ratio);emit log_named_uint("gasSpikePlaySurchargeShortfall",l.pay-l.surcharge);assertGe(l.surcharge,l.pay,"O11 surcharge-only maintenance promise");}
}
