pragma solidity 0.8.28;
import {IndependentB,HostilePolicyB,MoneyB} from "./IndependentB.t.sol";
import {PoolBalancer} from "../src/PoolBalancer.sol";
contract RemainingRequirementsB is IndependentB {
 function testEconomicDisableReleasesHoldThenBuyerUnpaidRecovery() public {start(20,1 ether,2500);(uint fee,,)=pool.quoteAcquisitionPrice(1);buy(buyer,1);vm.prank(creator);balancer.close();assertGt(balancer.requiredReserve(),0);vm.prank(creator);balancer.setPaidUpkeepEnabled(false);assertEq(balancer.requiredReserve(),0);uint free=balancer.withdrawableSurplus();vm.prank(creator);balancer.claimSurplus(free,creator);assertEq(address(balancer).balance,0);vm.roll(block.number+31);vm.prank(buyer);balancer.performUpkeepUnpaid();assertEq(pool.unsettledAcquisitionCount(),0);assertEq(MoneyB(address(pool)).acquisitionRefundCredit(buyer),fee);uint before=buyer.balance;vm.prank(buyer);MoneyB(address(pool)).withdrawAcquisitionRefund();assertEq(buyer.balance-before,fee);unwind();}
 function testEconomicPolicyActivationCannotSpendBookedProfit() public {start(20,0.2356 ether,10000);uint w=wordForSlot(2);uint[] memory req=buy(buyer,1);fulfill(req[0],w);quiesce();uint booked=balancer.profit();assertGt(booked,0);fees(4.95 gwei);HostilePolicyB p=new HostilePolicyB();vm.prank(creator);balancer.proposeKeeperPolicy(address(p));vm.warp(block.timestamp+2 days);(uint need,)=balancer.policyFunding(address(p));uint bal=address(balancer).balance;if(need>bal){vm.prank(creator);balancer.depositETH{value:need-bal}();}assertEq(address(balancer).balance,need,"gross liquidity exactly target");(,uint gap)=balancer.policyFunding(address(p));assertEq(gap,booked,"only profit is excluded");vm.expectRevert();balancer.activateKeeperPolicy();assertEq(balancer.profit(),booked);vm.prank(creator);balancer.depositETH{value:booked}();balancer.activateKeeperPolicy();assertEq(balancer.profit(),booked);assertEq(address(pool),address(balancer.pool()));emit log_named_uint("activationProtectedProfit",booked);emit log_named_uint("activationNewRequirement",need);unwind();}
 function testSecurityFactoryPolicyAdminHandoffCancelsQueuedDefault() public {start(20,1 ether,2500);HostilePolicyB p=new HostilePolicyB();address old=factory.defaultKeeperPolicy();vm.prank(keeperAdmin);vm.expectRevert();factory.proposeDefaultKeeperPolicy(address(p));factory.proposeDefaultKeeperPolicy(address(p));factory.transferPolicyAdmin(stranger);vm.prank(stranger);factory.acceptPolicyAdmin();assertEq(factory.pendingDefaultKeeperPolicy(),address(0));assertEq(factory.defaultKeeperPolicy(),old);assertEq(factory.keeperAdmin(),keeperAdmin);vm.warp(block.timestamp+2 days);vm.expectRevert();factory.activateDefaultKeeperPolicy();unwind();}
 function testEconomicQuietHalfGwei() public {runRegime(0.5 gwei,180);}
 function testEconomicQuietTwoGwei() public {runRegime(1.95 gwei,180);}
}
