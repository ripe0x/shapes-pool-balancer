pragma solidity 0.8.28;
import {IndependentB,HostilePolicyB,MoneyB} from "./IndependentB.t.sol";
import {PoolBalancer} from "../src/PoolBalancer.sol";
import {IERC721Min} from "../src/interfaces/External.sol";
import {ListOne} from "../test/utils/ListOne.sol";
using ListOne for PoolBalancer;
contract AdditionalEconomicB is IndependentB {
 function testEconomicMinimumPartialLargeWinThenDropAndTopup() public {uint t=uint(20)|(uint(1)<<48);start(t,0.75 ether,2500);uint lid;uint[] memory a=balancer.getActiveIds();for(uint i;i<a.length;i++){(uint8 k,uint8 d,,,)=balancer.items(a[i]);if(k==2&&d==3)lid=a[i];}(,,,,,,uint slot,)=pool.listings(lid);uint word=wordForSlot(slot);uint[] memory req=buy(buyer,1);fulfill(req[0],word);quiesce();(,,,uint won,uint8 status,)=pool.acquisitions(req[0]);assertEq(won,lid);assertEq(status,2);assertEq(balancer.getActiveShapes()[3],0,"adverse prize not magically replaced");assertEq(balancer.admissionStatus(),0,"small backing dominates admission");snap("minimum large win remains depleted");uint need=balancer.requiredReserve();assertGt(need,address(balancer).balance-balancer.profit());vm.prank(creator);balancer.configure(2500,20);assertEq(balancer.admissionStatus(),0);assertLt(balancer.requiredReserve(),need);vm.prank(creator);balancer.configure(2500,t);uint gap=balancer.requiredReserve()-(address(balancer).balance-balancer.profit());vm.prank(creator);balancer.depositETH{value:gap}();quiesce();assertEq(balancer.getActiveShapes()[3],1);snap("funded topup restored large prize");unwind();}
 function testEconomicSmallestLargestCountsAndDenominationBounds() public {fees(0.1 gwei);start(1,1 ether,1000);assertEq(balancer.getActiveShapes()[0],1);uint w=wordForSlot(2);uint[] memory r=buy(buyer,1);assertEq(balancer.admissionStatus(),6);fulfill(r[0],w);quiesce();assertEq(balancer.admissionStatus(),0);unwind();}
 function testEconomicThousandBottomHeavyRoundTrip() public {fees(0.1 gwei);start(1000,12 ether,10000);assertEq(balancer.getActiveShapes()[0],1000);assertEq(balancer.listedRestockFees(),0.335 ether);(bool ok,bytes memory out)=address(balancer).staticcall{gas:100000}(abi.encodeCall(PoolBalancer.canPurchase,(buyer)));assertTrue(ok,"gate remains under 100k");assertTrue(abi.decode(out,(bool)));snap("1000 lowest denominations fully stocked");unwind();}
 function testEconomicHighestDenominationRoundTrip() public {fees(4.95 gwei);start(uint(1)<<128,101 ether,10000);assertEq(balancer.getActiveShapes()[8],1);assertEq(balancer.listedRestockFees(),0.0047 ether);snap("one 100 ETH prize");unwind();}
 function testEconomicAllPackSizesRedeemAtExactBacking() public {uint target;uint totalBacking;for(uint d=9;d<16;d++){target|=uint(1)<<(16*d);}start(target,35 ether,1000);uint[] memory ids=balancer.getActiveIds();for(uint i;i<ids.length;i++){(uint8 kind,uint8 d,,,)=balancer.items(ids[i]);if(kind==2)totalBacking+=balancer.denominationAmount(d);}assertEq(totalBacking,30 ether);snap("all pack denominations");uint before=address(balancer).balance;uint[] memory shapes=new uint[](7);uint n;for(uint i;i<ids.length;i++){(uint8 k,,,,)=balancer.items(ids[i]);if(k==2)shapes[n++]=ids[i];}vm.prank(creator);balancer.close();vm.prank(creator);balancer.unlistShapes(shapes);assertEq(address(balancer).balance-before,30 ether);unwind();}
 function testEconomicPolicySwitchInFlightNeverReprices() public {start(board(),5 ether,2500);uint[] memory beforeIds=balancer.getActiveIds();uint[] memory prices=new uint[](beforeIds.length);for(uint i;i<beforeIds.length;i++){(,,,,,prices[i],,)=pool.listings(beforeIds[i]);}uint[] memory req=buy(buyer,2);HostilePolicyB p=new HostilePolicyB();vm.prank(creator);balancer.proposeKeeperPolicy(address(p));vm.warp(block.timestamp+2 days);balancer.activateKeeperPolicy();for(uint i;i<beforeIds.length;i++){(,,,,,uint price,,)=pool.listings(beforeIds[i]);assertEq(price,prices[i]);}fulfill(req[1],2);fulfill(req[0],1);quiesce();assertEq(pool.unsettledAcquisitionCount(),0);assertLe(balancer.availableKeeperAllowance(),0.622 ether);snap("policy changed outstanding draws");unwind();}
}
