# Chain the dashboard talks to: 1 (mainnet) or 31337 (local fork rehearsal)
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
# BalancerFactory address (see deployments/<chainId>.json)
VITE_FACTORY=
# Block to scan BalancerCreated events from
VITE_FROM_BLOCK=26382349
# Local fork only: unlocked anvil account used by the dev connector
VITE_DEV_ACCOUNT=
# Optional: WalletConnect Cloud project ID; enables mobile and QR wallets in the connect dialog
VITE_WALLETCONNECT_PROJECT_ID=
# Optional Alchemy key for wallet NFTs, images and OpenSea floor prices. Empty uses Alchemy's public "demo" key
# (rate limited). The key ships in the page: restrict it to your site's domain in the Alchemy dashboard.
VITE_ALCHEMY_KEY=
