# Chain the dashboard talks to: 1 (mainnet) or 31337 (local fork rehearsal)
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
# BalancerFactory address (see deployments/<chainId>.json)
VITE_FACTORY=0x96fd7B2e83E04Ea2e78be415e0BC82A1332e7671
# FWA main pool (ripe0x/shapes-fwa-pool). Mainnet: PackVault 0x9aBbF7835240dE0dAfC7d2e512E6dA15eb0D0b46,
# PackManagerFactory 0x0b436FFf393879aAe6dBdF118E9C631974731b64, deployed in block 26475514.
# Unset VITE_VAULT hides the Main pool section; unset VITE_MANAGER_FACTORY hides personal managers.
VITE_VAULT=
VITE_MANAGER_FACTORY=
# Block to scan ManagerCreated events from
VITE_MAIN_FROM_BLOCK=26475514
# Block to scan BalancerCreated events from
VITE_FROM_BLOCK=26499988
# Local fork only: unlocked anvil account used by the dev connector
VITE_DEV_ACCOUNT=
# Optional: WalletConnect Cloud project ID; enables mobile and QR wallets in the connect dialog
VITE_WALLETCONNECT_PROJECT_ID=
# Optional Alchemy key for wallet NFTs, images and OpenSea floor prices. Empty uses Alchemy's public "demo" key
# (rate limited). The key ships in the page: restrict it to your site's domain in the Alchemy dashboard.
VITE_ALCHEMY_KEY=
