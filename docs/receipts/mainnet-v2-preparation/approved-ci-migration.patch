+      # V2 fee/inventory regressions replace superseded manual-fee suites. The full campaign remains separate (R113).
+      - if: steps.changes.outputs.full == 'true'
+        run: |
+          SOURCE_HASH=$(python3 - <<'PYHASH'
+          import hashlib, json, pathlib, subprocess
+          config = json.loads(pathlib.Path('asset-flow-focused.json').read_text())
+          paths = config['source_paths'] + config.get('evidence_paths', [])
+          files = subprocess.check_output(['git', 'ls-files', '-z', '--', *paths]).decode().split('\0')
+          digest = hashlib.sha256()
+          for name in sorted(f for f in files if f):
+              path = pathlib.Path(name)
+              if path.is_file():
+                  digest.update(name.encode() + b'\0' + path.read_bytes() + b'\0')
+          print(digest.hexdigest())
+          PYHASH
+          )
+          export SOURCE_HASH
+          bash scripts/focused-release-check.sh
